# PUBLIC project token only; leave empty until a real PostHog project is supplied.
VITE_POSTHOG_PUBLIC_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com, matching your project region.
VITE_POSTHOG_HOST=
# Optional: force test traffic. Non-production origins are always test traffic.
VITE_POSTHOG_TRAFFIC=test
# Never place a PostHog personal API key, secret project key, or management token here.
